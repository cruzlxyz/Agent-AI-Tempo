# Telegram bot token — get from @BotFather on Telegram
TELEGRAM_TOKEN=***

# Comma-separated list of allowed Telegram user IDs.
# Get yours by messaging @userinfobot on Telegram.
# Leave empty to disable (anyone can use the bot — NOT recommended for public bots).
ALLOWED_USERS=

# Per-user cooldown in milliseconds (default 5000 = 5 seconds)
COOLDOWN_MS=5000

# GPT model (Tempo MPP-compatible)
GPT_MODEL=gpt-4o-mini
GPT_URL=https://openai.mpp.tempo.xyz/v1/chat/completions

# DeepSeek model
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://deepseek.mpp.paywithlocus.com/deepseek/chat

# Exa Search
EXA_URL=https://exa.mpp.tempo.xyz/search

# Request timeout in milliseconds (default 120000 = 2 minutes)
REQUEST_TIMEOUT_MS=120000
